{
  "name": "json-grabber",
  "version": "1.0.0",
  "private": true,
  "description": "Local DevTools extension that captures JSON response bodies.",
  "scripts": {
    "build": "esbuild src/panel.tsx --bundle --format=iife --jsx=automatic --target=chrome120 --minify --define:process.env.NODE_ENV=\\\"production\\\" --outfile=extension/panel.js",
    "dev": "node dev/dev.mjs",
    "watch": "esbuild src/panel.tsx --bundle --format=iife --jsx=automatic --target=chrome120 --outfile=extension/panel.js --watch",
    "typecheck": "tsc -b",
    "test": "jest"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src"
    ],
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.test.json"
        }
      ]
    }
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@lezer/highlight": "^1.2.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "@types/jest": "^30.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "esbuild": "^0.23.0",
    "jest": "^30.5.2",
    "oxlint": "^1.85.0",
    "ts-jest": "^29.4.14",
    "typescript": "^5.5.0"
  }
}
