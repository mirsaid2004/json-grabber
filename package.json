{
  "name": "json-grabber",
  "version": "1.0.0",
  "private": true,
  "description": "Local DevTools extension that captures JSON response bodies.",
  "scripts": {
    "build": "esbuild src/panel.tsx --bundle --format=iife --jsx=automatic --target=chrome120 --outfile=extension/panel.js",
    "watch": "npm run build -- --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "esbuild": "^0.23.0",
    "typescript": "^5.5.0"
  }
}
